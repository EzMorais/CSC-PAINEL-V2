package estoque

import "siqueiracampos/servidor/templates/layout"

templ Pagina(titulo string) {
	@layout.Base(titulo + " — Almoxarifado") {
		<nav class="cabecalho" data-testid="navegacao">
			<a href="/almoxarifado">Almoxarifado</a>
			<div style="display:flex;gap:0.75rem;align-items:center">
				<a href="/almoxarifado/materiais">Materiais</a>
				<a href="/almoxarifado/movimentacoes">Movimentações</a>
				<a href="/almoxarifado/solicitacoes">Solicitações</a>
				<a href="/almoxarifado/aprovacoes">Aprovações</a>
				<a href="/almoxarifado/configuracoes">Configurações</a>
				<form method="POST" action="/sair" style="display:inline">
					<button type="submit" data-testid="sair" aria-label="Sair">Sair</button>
				</form>
			</div>
		</nav>
		<main class="conteudo">
			{ children... }
		</main>
	}
}
