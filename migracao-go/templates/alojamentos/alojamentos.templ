package alojamentos

import (
	"fmt"
	dominio "siqueiracampos/servidor/internal/domain/alojamentos"
	"siqueiracampos/servidor/templates/layout"
)

type Opcao struct { ID, Rotulo, Extra string }
func texto(p *string) string { if p == nil { return "" }; return *p }
func acaoAloj(id string) string { if id == "" { return "/alojamentos/cadastros" }; return "/alojamentos/cadastros/"+id }
func boolInverso(v bool) string { if v { return "false" }; return "true" }
func rotuloAtivo(v bool) string { if v { return "Ativo" }; return "Inativo" }
func rotuloAlternar(v bool) string { if v { return "Inativar" }; return "Ativar" }
func capacidade(v *int) string { if v == nil { return "" }; return fmt.Sprint(*v) }

templ Pagina(titulo string) {
	@layout.Base(titulo + " — Alojamentos") {
		<nav class="abas">
			<a href="/alojamentos">Visão geral</a><a href="/alojamentos/cadastros">Alojamentos</a>
			<a href="/alojamentos/moradores">Moradores</a><a href="/alojamentos/pedidos">Pedidos</a>
			<a href="/alojamentos/programacao">Programação</a><a href="/alojamentos/rotas">Rotas</a>
		</nav>
		{ children... }
	}
}

templ Dashboard(i dominio.Indicadores, programacao []dominio.Programacao, pedidos []dominio.Pedido) {
	@Pagina("Alojamentos") {
		<h1>Alojamentos</h1>
		<div class="grade-kpis"><div class="bloco"><p>Alojamentos ativos</p><strong>{ fmt.Sprint(i.AlojamentosAtivos) }</strong></div><div class="bloco"><p>Moradores</p><strong>{ fmt.Sprint(i.Moradores) }</strong></div><div class="bloco"><p>Vagas</p><strong>{ fmt.Sprint(i.Vagas) }</strong></div><div class="bloco"><p>Pedidos abertos</p><strong>{ fmt.Sprint(i.PedidosAbertos) }</strong></div></div>
		<h2>Próxima programação</h2><ul>
			for _, p := range programacao {
				<li>{ p.Data.Format("02/01") } — { p.Titulo }</li>
			}
		</ul>
		<h2>Pedidos recentes</h2><ul>
			for _, p := range pedidos {
				<li>{ p.AlojamentoNome } — { p.Titulo } — { p.Status }</li>
			}
		</ul>
	}
}

templ ListaAlojamentos(lista []dominio.Alojamento) {
	@Pagina("Alojamentos") {
		<h1>Alojamentos</h1><details><summary class="botao botao-primario">+ Novo alojamento</summary>@FormAlojamento("", dominio.Alojamento{})</details>
		<table><thead><tr><th>Nome</th><th>Local</th><th>Ocupação</th><th>Status</th></tr></thead><tbody>
			for _, a := range lista {
				<tr><td><a href={ "/alojamentos/cadastros/"+a.ID }>{ a.Nome }</a></td><td>{ texto(a.Cidade) }/{ texto(a.UF) }</td><td>{ fmt.Sprint(a.Ocupacao) }</td><td>{ rotuloAtivo(a.Ativo) }</td></tr>
			}
		</tbody></table>
	}
}

templ FormAlojamento(id string, a dominio.Alojamento) {
	<form class="formulario" method="POST" action={ acaoAloj(id) }>
		<div class="campo"><label>Nome</label><input name="nome" value={ a.Nome } required/></div>
		<div class="campo"><label>CEP</label><input name="cep" value={ texto(a.CEP) }/></div>
		<div class="campo"><label>Logradouro</label><input name="logradouro" value={ texto(a.Logradouro) }/></div>
		<div class="campo"><label>Número</label><input name="numero" value={ texto(a.Numero) }/></div>
		<div class="campo"><label>Cidade</label><input name="cidade" value={ texto(a.Cidade) }/></div>
		<div class="campo"><label>UF</label><input name="uf" value={ texto(a.UF) }/></div>
		<div class="campo"><label>Responsável</label><input name="responsavel" value={ texto(a.ResponsavelNome) }/></div>
		<div class="campo"><label>Telefone</label><input name="telefone" value={ texto(a.TelefoneResponsavel) }/></div>
		<div class="campo"><label>Capacidade provisória</label><input type="number" name="capacidade" value={ capacidade(a.CapacidadeTotal) }/></div>
		<div class="campo"><label>Observações</label><textarea name="observacoes">{ texto(a.Observacoes) }</textarea></div><button>Salvar</button>
	</form>
}

templ DetalheAlojamento(a dominio.Alojamento) {
	@Pagina(a.Nome) {
		<h1>{ a.Nome }</h1>@FormAlojamento(a.ID,a)
		<form method="POST" action={ "/alojamentos/cadastros/"+a.ID+"/alternar" }><input type="hidden" name="ativo" value={ boolInverso(a.Ativo) }/><button>{ rotuloAlternar(a.Ativo) }</button></form>
		<h2>Grupo de WhatsApp</h2><form method="POST" action={ "/alojamentos/cadastros/"+a.ID+"/whatsapp" }><input name="grupoId" value={ texto(a.GrupoWhatsappID) } placeholder="Identificador do grupo"/><button>Vincular grupo</button></form>
		<h2>Quartos</h2><form class="formulario" method="POST" action={ "/alojamentos/cadastros/"+a.ID+"/quartos" }><input name="numero" placeholder="Número/nome" required/><input name="capacidade" type="number" min="1" value="1"/><select name="tipo"><option value="">Não informado</option><option>MASCULINO</option><option>FEMININO</option><option>MISTO</option></select><button>Criar quarto</button></form>
		<table><tbody>
			for _,q:=range a.Quartos {
				<tr><td>{ q.Numero }</td><td>{ fmt.Sprintf("%d/%d",q.Ocupacao,q.Capacidade) }</td><td><form method="POST" action={ "/alojamentos/quartos/"+q.ID+"/alternar" }><input type="hidden" name="alojamentoId" value={ a.ID }/><input type="hidden" name="ativo" value={ boolInverso(q.Ativo) }/><button>{ rotuloAlternar(q.Ativo) }</button></form></td></tr>
			}
		</tbody></table>
	}
}

templ Moradores(lista []dominio.Alocacao, funcionarios, alojamentos, rotas []Opcao) {
	@Pagina("Moradores") {
		<h1>Moradores</h1><details><summary class="botao botao-primario">+ Alocar morador</summary><form class="formulario" method="POST" action="/alojamentos/moradores">
			<select name="funcionarioId">
				for _,o:=range funcionarios {
					<option value={ o.ID }>{ o.Rotulo }</option>
				}
			</select><input name="funcionarioNome" placeholder="Nome"/><input name="matricula" placeholder="Matrícula"/>
			<select name="alojamentoId">
				for _,o:=range alojamentos {
					<option value={ o.ID }>{ o.Rotulo }</option>
				}
			</select><input name="quartoId" placeholder="ID do quarto (opcional)"/><input type="date" name="dataEntrada" required/>
			<select name="transporte"><option>PROPRIO</option><option>CARONA</option><option>ONIBUS</option></select><select name="rotaId"><option value="">Sem rota</option>
				for _,o:=range rotas {
					<option value={ o.ID }>{ o.Rotulo }</option>
				}
			</select><input name="telefone" placeholder="Telefone"/><button>Alocar</button>
		</form></details>
		<table><thead><tr><th>Morador</th><th>Alojamento</th><th>Quarto</th><th>Transporte</th><th>Ação</th></tr></thead><tbody>
			for _,a:=range lista {
				<tr><td>{ a.FuncionarioNome }<br/><small>{ a.FuncionarioMatricula }</small></td><td>{ a.AlojamentoNome }</td><td>{ a.QuartoNumero }</td><td>{ a.TransporteTipo }</td><td>
					if a.Status==dominio.AlocacaoAtiva {
						<form method="POST" action={ "/alojamentos/moradores/"+a.ID+"/encerrar" }><input type="date" name="dataSaida" required/><input name="motivo" placeholder="Motivo"/><button>Encerrar</button></form>
					} else {
						<span>Encerrada</span>
					}
				</td></tr>
			}
		</tbody></table>
	}
}

templ Pedidos(lista []dominio.Pedido, alojamentos []Opcao) {
	@Pagina("Pedidos") {
		<h1>Pedidos</h1><details><summary class="botao botao-primario">+ Novo pedido</summary><form class="formulario" method="POST" action="/alojamentos/pedidos"><select name="alojamentoId">
			for _,o:=range alojamentos {
				<option value={ o.ID }>{ o.Rotulo }</option>
			}
		</select><select name="tipo"><option>LIMPEZA</option><option>MANUTENCAO</option><option>PESSOAL</option></select><input name="titulo" placeholder="Pedido"/><textarea name="descricao"></textarea><select name="prioridade"><option>BAIXA</option><option selected>NORMAL</option><option>ALTA</option></select><button>Registrar</button></form></details>
		<table><tbody>
			for _,p:=range lista {
				<tr><td>{ p.AlojamentoNome }</td><td>{ p.Titulo }</td><td>{ p.Status }</td><td>
					if p.Status!=dominio.PedidoAtendido && p.Status!=dominio.PedidoCancelado {
						<form method="POST" action={ "/alojamentos/pedidos/"+p.ID+"/status" }><select name="status"><option>EM_ANDAMENTO</option><option>ATENDIDO</option><option>CANCELADO</option></select><input name="observacao" placeholder="Resposta"/><button>Atualizar</button></form>
					}
				</td></tr>
			}
		</tbody></table>
	}
}

templ Programacao(lista []dominio.Programacao, alojamentos []Opcao) {
	@Pagina("Programação") {
		<h1>Programação</h1><form class="formulario" method="POST" action="/alojamentos/programacao"><input type="date" name="data" required/><select name="tipo"><option>ONIBUS</option><option>LIMPEZA</option><option>REFEICAO</option><option>MANUTENCAO</option><option>AVISO</option></select><input name="titulo" placeholder="O que vai acontecer"/><input name="horario" placeholder="Horário"/><select name="alojamentoId"><option value="">Todos</option>
			for _,o:=range alojamentos {
				<option value={ o.ID }>{ o.Rotulo }</option>
			}
		</select><button>Adicionar</button></form>
		<ul>
			for _,p:=range lista {
				<li>{ p.Data.Format("02/01/2006") } — { p.Titulo } <form style="display:inline" method="POST" action={ "/alojamentos/programacao/"+p.ID+"/excluir" }><button>Excluir</button></form></li>
			}
		</ul>
	}
}

templ Rotas(lista []dominio.Rota) {
	@Pagina("Rotas") {
		<h1>Rotas de ônibus</h1><form class="formulario" method="POST" action="/alojamentos/rotas"><input name="nome" placeholder="Nome"/><input name="motorista" placeholder="Motorista"/><input name="veiculo" placeholder="Veículo"/><input name="horarioIda" placeholder="Ida"/><input name="horarioVolta" placeholder="Volta"/><input type="number" name="capacidade" placeholder="Capacidade"/><button>Criar</button></form>
		<table><tbody>
			for _,r:=range lista {
				<tr><td>{ r.Nome }</td><td>{ texto(r.Motorista) }</td><td>{ texto(r.HorarioIda) } / { texto(r.HorarioVolta) }</td><td><form method="POST" action={ "/alojamentos/rotas/"+r.ID+"/alternar" }><input type="hidden" name="ativo" value={ boolInverso(r.Ativo) }/><button>{ rotuloAlternar(r.Ativo) }</button></form></td></tr>
			}
		</tbody></table>
	}
}
