package layout

import "siqueiracampos/servidor/internal/domain/identidade"

// Sidebar — casca fixa e sempre escura compartilhada pelos 3 módulos já unificados neste
// binário (Identidade/Portal, Painel de Locação, Almoxarifado). Ver DESIGN-SYSTEM.md §2/§6 e
// apps/rh/src/components/layout/sidebar.tsx (referência React equivalente). Recolher/abrir
// drawer/tema são só CSS + static/app.js — o Go só decide QUAIS seções aparecem, por
// permissão (`identidade.TemAcesso`), igual a `handlers/identidade/hub.go` já faz pro Hub.
templ Sidebar(sess identidade.Sessao) {
	<nav class="barra-lateral" id="barra-lateral" data-testid="navegacao">
		<div class="barra-lateral-topo">
			<span class="marca">
				<strong>Siqueira Campos</strong>
				<small>Sistemas internos</small>
			</span>
			<button type="button" class="botao-icone somente-mobile" data-fechar-menu aria-label="Fechar menu">
				@IconeX("icone")
			</button>
			<button type="button" class="botao-icone somente-desktop" data-alternar-tema aria-label="Alternar tema">
				@IconeLua("icone icone-tema-escuro")
				@IconeSol("icone icone-tema-claro")
			</button>
		</div>
		<div class="barra-lateral-secoes">
			<div class="secao-nav">
				<a href="/" class="item-nav" data-nav title="Hub">
					@IconeDashboard("icone")
					<span class="rotulo">Hub</span>
				</a>
				if identidade.PodeAdministrar(sess.Cargo) {
					<a href="/usuarios" class="item-nav" data-nav title="Usuários">
						@IconeUsuarios("icone")
						<span class="rotulo">Usuários</span>
					</a>
				}
			</div>
			if identidade.TemAcesso(sess, identidade.ModuloPainel) {
				<div class="secao-nav">
					<p class="secao-titulo">Painel de Locação</p>
					<a href="/painel" class="item-nav" data-nav title="Dashboard">
						@IconeDashboard("icone")
						<span class="rotulo">Dashboard</span>
					</a>
					<a href="/painel/locacoes" class="item-nav" data-nav title="Locações">
						@IconePredio("icone")
						<span class="rotulo">Locações</span>
					</a>
					<a href="/painel/obras" class="item-nav" data-nav title="Obras">
						@IconePredio("icone")
						<span class="rotulo">Obras</span>
					</a>
					<a href="/painel/fornecedores" class="item-nav" data-nav title="Fornecedores">
						@IconePacote("icone")
						<span class="rotulo">Fornecedores</span>
					</a>
					<a href="/painel/importar" class="item-nav" data-nav title="Importar">
						@IconePacote("icone")
						<span class="rotulo">Importar</span>
					</a>
				</div>
			}
			if identidade.TemAcesso(sess, identidade.ModuloEstoque) {
				<div class="secao-nav">
					<p class="secao-titulo">Almoxarifado</p>
					<a href="/almoxarifado" class="item-nav" data-nav title="Dashboard">
						@IconeDashboard("icone")
						<span class="rotulo">Dashboard</span>
					</a>
					<a href="/almoxarifado/materiais" class="item-nav" data-nav title="Materiais">
						@IconePacote("icone")
						<span class="rotulo">Materiais</span>
					</a>
					<a href="/almoxarifado/movimentacoes" class="item-nav" data-nav title="Movimentações">
						@IconePacote("icone")
						<span class="rotulo">Movimentações</span>
					</a>
					<a href="/almoxarifado/solicitacoes" class="item-nav" data-nav title="Solicitações">
						@IconePacote("icone")
						<span class="rotulo">Solicitações</span>
					</a>
					<a href="/almoxarifado/aprovacoes" class="item-nav" data-nav title="Aprovações">
						@IconeCheck("icone")
						<span class="rotulo">Aprovações</span>
					</a>
					<a href="/almoxarifado/configuracoes" class="item-nav" data-nav title="Configurações">
						@IconeUsuarios("icone")
						<span class="rotulo">Configurações</span>
					</a>
				</div>
			}
			if identidade.TemAcesso(sess, identidade.ModuloRH) {
				<div class="secao-nav">
					<p class="secao-titulo">RH e SST</p>
					<a href="/rh" class="item-nav" data-nav title="Dashboard">
						@IconeDashboard("icone")
						<span class="rotulo">Dashboard</span>
					</a>
					<a href="/rh/funcionarios" class="item-nav" data-nav title="Funcionários">
						@IconeUsuarios("icone")
						<span class="rotulo">Funcionários</span>
					</a>
					<a href="/rh/configuracoes" class="item-nav" data-nav title="Configurações">
						@IconeUsuarios("icone")
						<span class="rotulo">Configurações</span>
					</a>
				</div>
			}
			if identidade.TemAcesso(sess, identidade.ModuloAlojamentos) {
				<div class="secao-nav">
					<p class="secao-titulo">Alojamentos</p>
					<a href="/alojamentos" class="item-nav" data-nav title="Dashboard">
						@IconeDashboard("icone")
						<span class="rotulo">Dashboard</span>
					</a>
					<a href="/alojamentos/cadastros" class="item-nav" data-nav title="Alojamentos">
						@IconeCasa("icone")
						<span class="rotulo">Alojamentos</span>
					</a>
					<a href="/alojamentos/moradores" class="item-nav" data-nav title="Moradores">
						@IconeUsuarios("icone")
						<span class="rotulo">Moradores</span>
					</a>
					<a href="/alojamentos/pedidos" class="item-nav" data-nav title="Pedidos">
						@IconePacote("icone")
						<span class="rotulo">Pedidos</span>
					</a>
					<a href="/alojamentos/programacao" class="item-nav" data-nav title="Programação">
						@IconeDashboard("icone")
						<span class="rotulo">Programação</span>
					</a>
					<a href="/alojamentos/rotas" class="item-nav" data-nav title="Rotas">
						@IconePredio("icone")
						<span class="rotulo">Rotas</span>
					</a>
				</div>
			}
			if identidade.TemAcesso(sess, identidade.ModuloFinanceiro) {
				<div class="secao-nav">
					<p class="secao-titulo">Financeiro</p>
					<a href="/financeiro" class="item-nav" data-nav title="Dashboard">
						@IconeDashboard("icone")
						<span class="rotulo">Dashboard</span>
					</a>
					<a href="/financeiro/faturamento" class="item-nav" data-nav title="Faturamento">
						@IconeCifrao("icone")
						<span class="rotulo">Faturamento</span>
					</a>
					<a href="/financeiro/fiscal" class="item-nav" data-nav title="Fiscal / SEFAZ">
						@IconePacote("icone")
						<span class="rotulo">Fiscal / SEFAZ</span>
					</a>
					<a href="/financeiro/contas-pagar" class="item-nav" data-nav title="Contas a pagar">
						@IconeCifrao("icone")
						<span class="rotulo">Contas a pagar</span>
					</a>
					<a href="/financeiro/contas-receber" class="item-nav" data-nav title="Contas a receber">
						@IconeCifrao("icone")
						<span class="rotulo">Contas a receber</span>
					</a>
				</div>
			}
			if identidade.TemAcesso(sess, identidade.ModuloProgramacao) {
				<div class="secao-nav">
					<p class="secao-titulo">Programação Diária</p>
					<a href="/programacao" class="item-nav" data-nav title="Hoje">
						@IconeCalendario("icone")
						<span class="rotulo">Hoje</span>
					</a>
					<a href="/programacao/frentes" class="item-nav" data-nav title="Frentes">
						@IconePredio("icone")
						<span class="rotulo">Frentes</span>
					</a>
					<a href="/programacao/funcionarios" class="item-nav" data-nav title="Funcionários">
						@IconeUsuarios("icone")
						<span class="rotulo">Funcionários</span>
					</a>
					<a href="/programacao/veiculos" class="item-nav" data-nav title="Veículos">
						@IconePacote("icone")
						<span class="rotulo">Veículos</span>
					</a>
					<a href="/programacao/funcoes" class="item-nav" data-nav title="Funções">
						@IconeUsuarios("icone")
						<span class="rotulo">Funções</span>
					</a>
				</div>
			}
		</div>
		<div class="barra-lateral-rodape">
			<div class="usuario-info">
				<p class="usuario-nome" title={ sess.Nome }>{ sess.Nome }</p>
				<p class="usuario-email" title={ sess.Email }>{ sess.Email }</p>
			</div>
			<form method="POST" action="/sair">
				<button type="submit" data-testid="sair" class="item-nav item-nav-botao" title="Sair">
					@IconeSair("icone")
					<span class="rotulo">Sair</span>
				</button>
			</form>
			<button type="button" class="item-nav item-nav-botao somente-desktop" data-alternar-colapso aria-label="Recolher menu">
				@IconeChevronsEsquerda("icone icone-recolher")
				@IconeChevronsDireita("icone icone-expandir")
				<span class="rotulo">Recolher</span>
			</button>
		</div>
	</nav>
	<div class="fundo-menu" data-fundo-menu></div>
}
