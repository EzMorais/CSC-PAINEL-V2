package layout

// Header identifica o contexto atual e mantém as ações globais sempre acessíveis.
templ Header() {
	<header class="cabecalho-principal">
		<button type="button" class="botao-menu-mobile" data-abrir-menu aria-label="Abrir menu" aria-expanded="false">
			@IconeMenu("icone")
		</button>
		<div class="contexto-pagina">
			<span class="contexto-sistema">CSC Painel</span>
			<strong data-modulo-label>Sistemas internos</strong>
		</div>
		<div class="acoes-globais">
			<a href="/" class="atalho-hub" data-nav>@IconeGrade("icone")<span>Todos os módulos</span></a>
			<button type="button" class="botao-tema" data-alternar-tema aria-label="Alternar tema">
			@IconeLua("icone icone-tema-escuro")
			@IconeSol("icone icone-tema-claro")
			</button>
		</div>
	</header>
}
