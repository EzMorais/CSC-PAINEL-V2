package layout

// Ícones SVG do Lucide (MIT) inlinados à mão — sem lucide-react porque não há bundler JS
// neste binário. Mesmo conjunto de paths usado pelos apps Next.js, `stroke="currentColor"`
// herda a cor do elemento pai (ver DESIGN-SYSTEM.md §10).

templ IconeDashboard(classe string) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={ classe } aria-hidden="true">
		<rect width="7" height="9" x="3" y="3" rx="1"></rect>
		<rect width="7" height="5" x="14" y="3" rx="1"></rect>
		<rect width="7" height="9" x="14" y="12" rx="1"></rect>
		<rect width="7" height="5" x="3" y="16" rx="1"></rect>
	</svg>
}

