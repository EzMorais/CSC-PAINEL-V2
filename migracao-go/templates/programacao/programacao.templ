package programacao

import (
	"fmt"
	"time"

	dominio "siqueiracampos/servidor/internal/domain/programacao"
	"siqueiracampos/servidor/templates/layout"
)

func texto(p *string) string {
	if p == nil {
		return ""
	}
	return *p
}
func rotuloAtivo(v bool) string {
	if v {
		return "Ativo"
	}
	return "Inativo"
}
func rotuloAlternar(v bool) string {
	if v {
		return "Desativar"
	}
	return "Ativar"
}
func boolInverso(v bool) string {
	if v {
		return "false"
	}
	return "true"
}

var diasSemana = [...]string{"DOMINGO", "SEGUNDA-FEIRA", "TERÇA-FEIRA", "QUARTA-FEIRA", "QUINTA-FEIRA", "SEXTA-FEIRA", "SÁBADO"}

// tituloDoDia reproduz o título exato que o quadro original usa: "SEXTA-FEIRA 31/07/26".
func tituloDoDia(data time.Time) string {
	return fmt.Sprintf("%s %s", diasSemana[int(data.Weekday())], data.Format("02/01/06"))
}
func isoData(data time.Time) string { return data.Format(time.DateOnly) }
func diaAnterior(data time.Time) string { return data.AddDate(0, 0, -1).Format(time.DateOnly) }
func diaSeguinte(data time.Time) string { return data.AddDate(0, 0, 1).Format(time.DateOnly) }

func rotuloStatus(s dominio.StatusProgramacao) string {
	if s == dominio.StatusPublicada {
		return "Publicada"
	}
	return "Rascunho"
}
func rotuloGravidade(g dominio.Gravidade) string {
	if g == dominio.GravidadeAlta {
		return "alerta-alta"
	}
	return "alerta-media"
}
func corTexto(hex string) string {
	if len(hex) != 7 {
		return "#000000"
	}
	var r, g, b int
	fmt.Sscanf(hex[1:3], "%02x", &r)
	fmt.Sscanf(hex[3:5], "%02x", &g)
	fmt.Sscanf(hex[5:7], "%02x", &b)
	luminancia := 0.2126*float64(r) + 0.7152*float64(g) + 0.0722*float64(b)
	if luminancia > 140 {
		return "#000000"
	}
	return "#FFFFFF"
}

// escalasDaFrente/recursosDaFrente filtram a lista carregada do dia — mais simples que
// recarregar por frente e mantém o mesmo array já vindo do repositório.
func escalasDaFrente(escalas []dominio.Escala, frenteID string) []dominio.Escala {
	var out []dominio.Escala
	for _, e := range escalas {
		if e.FrenteID == frenteID {
			out = append(out, e)
		}
	}
	return out
}
func recursosDaFrente(recursos []dominio.Recurso, frenteID string) []dominio.Recurso {
	var out []dominio.Recurso
	for _, r := range recursos {
		if r.FrenteID == frenteID {
			out = append(out, r)
		}
	}
	return out
}

templ Pagina(titulo string) {
	@layout.Base(titulo + " — Programação Diária") {
		{ children... }
	}
}

templ Dia(data time.Time, p *dominio.Programacao, frentes []dominio.Frente, funcoes []dominio.Funcao, funcionarios []dominio.Funcionario, conflitos []dominio.Conflito) {
	@Pagina(tituloDoDia(data)) {
		<div class="linha-topo">
			<div>
				<h1>{ tituloDoDia(data) }</h1>
				if p != nil {
					<p class="email">
						<span class="selo">{ rotuloStatus(p.Status) }</span>
						if p.PublicadaEm != nil {
							· publicada por { texto(p.PublicadaPor) } em { p.PublicadaEm.Format("02/01 15:04") }
						}
					</p>
				}
			</div>
			<div class="linha-topo">
				<a class="botao botao-secundario" href={ templ.URL("/programacao/dia/" + diaAnterior(data)) }>← dia anterior</a>
				<a class="botao botao-secundario" href="/programacao">Hoje</a>
				<a class="botao botao-secundario" href={ templ.URL("/programacao/dia/" + diaSeguinte(data)) }>dia seguinte →</a>
			</div>
		</div>

		if p == nil {
			<section class="card">
				<p>Nenhuma programação lançada para este dia ainda.</p>
				<form method="post" action={ templ.URL("/programacao/dia/" + isoData(data) + "/criar") }>
					<button class="botao botao-primario" type="submit">Criar dia</button>
				</form>
				<form method="post" action={ templ.URL("/programacao/dia/" + isoData(data) + "/copiar") } style="margin-top:0.5rem">
					<input type="hidden" name="origem" value={ isoData(diaAnteriorRel(data)) }/>
					<button class="botao botao-secundario" type="submit">Copiar do dia anterior</button>
				</form>
			</section>
		} else {
			if len(conflitos) > 0 {
				<section class="card" data-testid="conflitos">
					<h2>Conflitos no quadro</h2>
					<ul>
						for _, c := range conflitos {
							<li class={ rotuloGravidade(c.Gravidade) }><strong>{ c.Titulo }</strong> — { c.Detalhe }</li>
						}
					</ul>
				</section>
			}

			<div class="linha-topo">
				<form method="post" action={ templ.URL("/programacao/dia/" + isoData(data) + "/copiar") }>
					<input type="hidden" name="origem" value={ isoData(diaAnteriorRel(data)) }/>
					<button class="botao botao-secundario" type="submit">Copiar do dia anterior (substitui este dia)</button>
				</form>
				if p.Status == dominio.StatusRascunho {
					<form method="post" action={ templ.URL("/programacao/dia/" + isoData(data) + "/publicar") }>
						<button class="botao botao-primario" type="submit">Publicar</button>
					</form>
				}
			</div>

			<div class="grade-frentes">
				for _, f := range frentes {
					@colunaFrente(f, frentes, escalasDaFrente(p.Escalas, f.ID), recursosDaFrente(p.Recursos, f.ID), funcoes, funcionarios, isoData(data))
				}
			</div>
		}
	}
}

// diaAnteriorRel existe só para não repetir a conta dentro do templ — mesma coisa que
// diaAnterior, nome diferente pra não colidir com o uso em cima do calendário.
func diaAnteriorRel(data time.Time) time.Time { return data.AddDate(0, 0, -1) }

templ colunaFrente(f dominio.Frente, todasFrentes []dominio.Frente, escalas []dominio.Escala, recursos []dominio.Recurso, funcoes []dominio.Funcao, funcionarios []dominio.Funcionario, dataIso string) {
	<section class="card" style={ "border-top:4px solid " + f.Cor }>
		<h2>{ f.Nome }</h2>
		<ul class="lista-usuarios">
			for _, e := range escalas {
				<li>
					<div class="linha-topo">
						<span class="nome">
							{ e.Nome }
							if e.FuncaoSigla != nil {
								<span class="selo">{ texto(e.FuncaoSigla) }</span>
							}
						</span>
						<form method="post" action={ templ.URL("/programacao/escalas/" + e.ID + "/tirar") }>
							<input type="hidden" name="dataIso" value={ dataIso }/>
							<button class="botao botao-secundario" type="submit">Tirar</button>
						</form>
					</div>
					<form method="post" action={ templ.URL("/programacao/escalas/" + e.ID + "/mover") } class="linha-topo">
						<input type="hidden" name="dataIso" value={ dataIso }/>
						<select name="frenteId">
							for _, destino := range todasFrentes {
								<option value={ destino.ID } selected?={ destino.ID == f.ID }>{ destino.Nome }</option>
							}
						</select>
						<button class="botao botao-secundario" type="submit">Mover</button>
					</form>
				</li>
			}
		</ul>
		<details>
			<summary class="botao botao-primario">+ Escalar</summary>
			<form class="formulario" method="post" action="/programacao/escalas">
				<input type="hidden" name="data" value={ dataIso }/>
				<input type="hidden" name="frenteId" value={ f.ID }/>
				<div class="campo">
					<label>Nome</label>
					<input name="nome" list={ "funcionarios-" + f.ID } required/>
					<datalist id={ "funcionarios-" + f.ID }>
						for _, func_ := range funcionarios {
							<option value={ func_.Nome }></option>
						}
					</datalist>
				</div>
				<div class="campo">
					<label>Função</label>
					<select name="funcaoSigla">
						<option value="">—</option>
						for _, fc := range funcoes {
							<option value={ fc.Sigla }>{ fc.Sigla } · { fc.Nome }</option>
						}
					</select>
				</div>
				<button type="submit">Escalar</button>
			</form>
		</details>

		<h3>Veículos, máquinas e avisos</h3>
		<ul class="lista-usuarios">
			for _, r := range recursos {
				<li>
					<div class="linha-topo">
						<span class="nome">
							{ r.Descricao }
							if r.Destaque {
								<span class="selo" style="background:var(--color-warning-soft);color:var(--color-warning)">Atenção</span>
							}
						</span>
						<form method="post" action={ templ.URL("/programacao/recursos/" + r.ID + "/tirar") }>
							<input type="hidden" name="dataIso" value={ dataIso }/>
							<button class="botao botao-secundario" type="submit">Tirar</button>
						</form>
					</div>
					<p class="email">
						if r.Placa != nil {
							{ texto(r.Placa) } ·
						}
						if r.MotoristaNome != nil {
							motorista: { texto(r.MotoristaNome) }
						} else if r.Tipo == dominio.RecursoVeiculo {
							sem motorista
						}
					</p>
				</li>
			}
		</ul>
		<details>
			<summary class="botao botao-primario">+ Veículo/máquina/aviso</summary>
			<form class="formulario" method="post" action="/programacao/recursos">
				<input type="hidden" name="data" value={ dataIso }/>
				<input type="hidden" name="frenteId" value={ f.ID }/>
				<div class="campo">
					<label>Tipo</label>
					<select name="tipo">
						<option value="VEICULO">Veículo</option>
						<option value="MAQUINA">Máquina</option>
						<option value="AVISO">Aviso</option>
					</select>
				</div>
				<div class="campo"><label>Descrição</label><input name="descricao" placeholder="DOBLO PXF 4H26" required/></div>
				<div class="campo"><label>Placa</label><input name="placa"/></div>
				<div class="campo"><label>Motorista</label><input name="motoristaNome"/></div>
				<div class="campo"><label><input type="checkbox" name="destaque" value="true"/> Destacar (ex.: manutenção)</label></div>
				<button type="submit">Adicionar</button>
			</form>
		</details>
	</section>
}

templ Frentes(lista []dominio.Frente) {
	@Pagina("Frentes") {
		<h1>Frentes</h1>
		<details open>
			<summary class="botao botao-primario">+ Nova frente</summary>
			<form class="formulario" method="post" action="/programacao/frentes">
				<div class="campo"><label>Nome</label><input name="nome" required/></div>
				<div class="campo"><label>Cor</label><input type="color" name="cor" value="#DDEBF7"/></div>
				<div class="campo"><label>Colunas na imagem</label><input type="number" name="colunas" min="1" max="4" value="1"/></div>
				<div class="campo"><label>Código da obra (RH, opcional)</label><input name="obraCodigo"/></div>
				<button type="submit">Criar</button>
			</form>
		</details>
		<table>
			<thead><tr><th>Nome</th><th>Cor</th><th>Colunas</th><th>Status</th><th>Ações</th></tr></thead>
			<tbody>
				for _, f := range lista {
					<tr>
						<td><span class="selo" style={ "background:" + f.Cor + ";color:" + corTexto(f.Cor) }>{ f.Nome }</span></td>
						<td>{ f.Cor }</td>
						<td>{ fmt.Sprint(f.Colunas) }</td>
						<td>{ rotuloAtivo(f.Ativa) }</td>
						<td>
							<form method="post" action={ templ.URL("/programacao/frentes/" + f.ID + "/alternar") } style="display:inline">
								<input type="hidden" name="ativa" value={ boolInverso(f.Ativa) }/>
								<button class="botao botao-secundario" type="submit">{ rotuloAlternar(f.Ativa) }</button>
							</form>
							<form method="post" action={ templ.URL("/programacao/frentes/" + f.ID + "/mover") } style="display:inline">
								<input type="hidden" name="direcao" value="cima"/>
								<button class="botao botao-secundario" type="submit">↑</button>
							</form>
							<form method="post" action={ templ.URL("/programacao/frentes/" + f.ID + "/mover") } style="display:inline">
								<input type="hidden" name="direcao" value="baixo"/>
								<button class="botao botao-secundario" type="submit">↓</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ Funcionarios(lista []dominio.Funcionario, funcoes []dominio.Funcao) {
	@Pagina("Funcionários") {
		<h1>Funcionários</h1>
		<p class="email">Cadastro fixo local — complementar ao RH, para quem a Programação escala todo dia sem estar cadastrado lá.</p>
		<details open>
			<summary class="botao botao-primario">+ Novo funcionário</summary>
			<form class="formulario" method="post" action="/programacao/funcionarios">
				<div class="campo"><label>Nome</label><input name="nome" required/></div>
				<div class="campo">
					<label>Função</label>
					<select name="funcaoSigla">
						<option value="">—</option>
						for _, fc := range funcoes {
							<option value={ fc.Sigla }>{ fc.Sigla } · { fc.Nome }</option>
						}
					</select>
				</div>
				<div class="campo">
					<label>Tipo</label>
					<select name="tipo"><option value="CSC">CSC</option><option value="PRESTADOR">Prestador</option></select>
				</div>
				<div class="campo"><label><input type="checkbox" name="motorista" value="true"/> É motorista</label></div>
				<button type="submit">Cadastrar</button>
			</form>
		</details>
		<table>
			<thead><tr><th>Nome</th><th>Função</th><th>Tipo</th><th>Status</th><th>Ações</th></tr></thead>
			<tbody>
				for _, f := range lista {
					<tr>
						<td>{ f.Nome }</td>
						<td>{ texto(f.FuncaoSigla) }</td>
						<td>{ f.Tipo }</td>
						<td>
							{ rotuloAtivo(f.Ativo) }
							if f.Ausente {
								<span class="selo" style="background:var(--color-warning-soft);color:var(--color-warning)">Ausente</span>
							}
						</td>
						<td>
							<form method="post" action={ templ.URL("/programacao/funcionarios/" + f.ID + "/alternar-ativo") } style="display:inline">
								<input type="hidden" name="ativo" value={ boolInverso(f.Ativo) }/>
								<button class="botao botao-secundario" type="submit">{ rotuloAlternar(f.Ativo) }</button>
							</form>
							<form method="post" action={ templ.URL("/programacao/funcionarios/" + f.ID + "/alternar-ausente") } style="display:inline">
								<input type="hidden" name="ausente" value={ boolInverso(f.Ausente) }/>
								<button class="botao botao-secundario" type="submit">
									if f.Ausente {
										Marcar disponível
									} else {
										Marcar ausente
									}
								</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ Veiculos(lista []dominio.Veiculo) {
	@Pagina("Veículos") {
		<h1>Veículos</h1>
		<p class="email">Cadastro fixo local de veículo/máquina de uso recorrente que não vem da Frota (alugado, de terceiro).</p>
		<details open>
			<summary class="botao botao-primario">+ Novo veículo</summary>
			<form class="formulario" method="post" action="/programacao/veiculos">
				<div class="campo"><label>Modelo</label><input name="modelo" required/></div>
				<div class="campo"><label>Placa</label><input name="placa"/></div>
				<div class="campo"><label>Motorista padrão</label><input name="motoristaNome"/></div>
				<button type="submit">Cadastrar</button>
			</form>
		</details>
		<table>
			<thead><tr><th>Modelo</th><th>Placa</th><th>Motorista</th><th>Status</th><th>Ações</th></tr></thead>
			<tbody>
				for _, v := range lista {
					<tr>
						<td>{ v.Modelo }</td>
						<td>{ texto(v.Placa) }</td>
						<td>{ texto(v.MotoristaNome) }</td>
						<td>{ rotuloAtivo(v.Ativo) }</td>
						<td>
							<form method="post" action={ templ.URL("/programacao/veiculos/" + v.ID + "/alternar") }>
								<input type="hidden" name="ativo" value={ boolInverso(v.Ativo) }/>
								<button class="botao botao-secundario" type="submit">{ rotuloAlternar(v.Ativo) }</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ Funcoes(lista []dominio.Funcao) {
	@Pagina("Funções") {
		<h1>Funções</h1>
		<p class="email">As siglas que saem depois do nome no quadro: PD, SO, ENG, MOT…</p>
		<details open>
			<summary class="botao botao-primario">+ Nova função</summary>
			<form class="formulario" method="post" action="/programacao/funcoes">
				<div class="campo"><label>Sigla</label><input name="sigla" required/></div>
				<div class="campo"><label>Nome</label><input name="nome" required/></div>
				<div class="campo"><label>Cargo correspondente no RH (opcional)</label><input name="cargoRh"/></div>
				<div class="campo"><label>Cor</label><input type="color" name="cor" value="#8B0000"/></div>
				<button type="submit">Criar</button>
			</form>
		</details>
		<table>
			<thead><tr><th>Sigla</th><th>Nome</th><th>Cor</th><th>Status</th><th>Ações</th></tr></thead>
			<tbody>
				for _, f := range lista {
					<tr>
						<td><span class="selo" style={ "background:" + f.Cor + ";color:" + corTexto(f.Cor) }>{ f.Sigla }</span></td>
						<td>{ f.Nome }</td>
						<td>{ f.Cor }</td>
						<td>{ rotuloAtivo(f.Ativa) }</td>
						<td>
							<form method="post" action={ templ.URL("/programacao/funcoes/" + f.ID + "/alternar") }>
								<input type="hidden" name="ativa" value={ boolInverso(f.Ativa) }/>
								<button class="botao botao-secundario" type="submit">{ rotuloAlternar(f.Ativa) }</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}
