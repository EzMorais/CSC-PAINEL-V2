package rh

type OpcaoSelect struct{ ID, Rotulo string }

type FormFuncionario struct {
	ID, Erro string
	Nome, CPF, RG, DataNascimento, Sexo, EstadoCivil, NomeMae, Foto string
	Telefone, Email string
	CEP, Logradouro, Numero, Complemento, Bairro, Cidade, UF string
	AdmitidoEm, Status, TipoContrato, ObraID, CargoID, DepartamentoID, NivelObra, Salario string
	Banco, Agencia, Conta, TipoConta, ChavePix string
	TamanhoCamisa, TamanhoCalca, TamanhoCalcado, Observacoes string
	Obras, Cargos, Departamentos []OpcaoSelect
}

templ FuncionarioForm(f FormFuncionario) {
	@Pagina("Funcionário") {
		<h1>{ tituloForm(f.ID) }</h1>
		<p>Campos marcados com * são necessários para concluir o cadastro.</p>
		<form class="formulario" method="POST" action={ acaoForm(f.ID) }>
			<h2>Identificação</h2>
			<div class="campo"><label for="nome">Nome completo *</label><input id="nome" name="nome" required value={ f.Nome }/></div>
			<div class="campo"><label for="cpf">CPF *</label><input id="cpf" name="cpf" required inputmode="numeric" value={ f.CPF }/></div>
			<div class="campo"><label for="rg">RG ou documento de identificação *</label><input id="rg" name="rg" required value={ f.RG }/></div>
			<div class="campo"><label for="dataNascimento">Data de nascimento *</label><input id="dataNascimento" name="dataNascimento" type="date" required value={ f.DataNascimento }/></div>
			<div class="campo"><label for="sexo">Sexo</label><select id="sexo" name="sexo"><option value="">Não informado</option><option value="FEMININO" selected?={ f.Sexo == "FEMININO" }>Feminino</option><option value="MASCULINO" selected?={ f.Sexo == "MASCULINO" }>Masculino</option><option value="OUTRO" selected?={ f.Sexo == "OUTRO" }>Outro</option></select></div>
			<div class="campo"><label for="estadoCivil">Estado civil</label><input id="estadoCivil" name="estadoCivil" value={ f.EstadoCivil }/></div>
			<div class="campo"><label for="nomeMae">Nome da mãe</label><input id="nomeMae" name="nomeMae" value={ f.NomeMae }/></div>
			<div class="campo"><label for="foto">Foto (data URI ou URL)</label><input id="foto" name="foto" value={ f.Foto }/></div>

			<h2>Contato e endereço</h2>
			<div class="campo"><label for="telefone">Telefone com DDD *</label><input id="telefone" name="telefone" required inputmode="tel" value={ f.Telefone }/></div>
			<div class="campo"><label for="email">E-mail</label><input id="email" name="email" type="email" value={ f.Email }/></div>
			<div class="campo"><label for="cep">CEP *</label><input id="cep" name="cep" required inputmode="numeric" value={ f.CEP }/></div>
			<div class="campo"><label for="logradouro">Logradouro *</label><input id="logradouro" name="logradouro" required value={ f.Logradouro }/></div>
			<div class="campo"><label for="numero">Número *</label><input id="numero" name="numero" required value={ f.Numero }/></div>
			<div class="campo"><label for="complemento">Complemento</label><input id="complemento" name="complemento" value={ f.Complemento }/></div>
			<div class="campo"><label for="bairro">Bairro *</label><input id="bairro" name="bairro" required value={ f.Bairro }/></div>
			<div class="campo"><label for="cidade">Cidade *</label><input id="cidade" name="cidade" required value={ f.Cidade }/></div>
			<div class="campo"><label for="uf">UF *</label><input id="uf" name="uf" required maxlength="2" value={ f.UF }/></div>

			<h2>Vínculo profissional</h2>
			<div class="campo"><label for="admitidoEm">Data de admissão *</label><input id="admitidoEm" name="admitidoEm" type="date" required value={ f.AdmitidoEm }/></div>
			<div class="campo"><label for="status">Situação *</label><select id="status" name="status" required><option value="ATIVO" selected?={ f.Status == "ATIVO" || f.Status == "" }>Ativo</option><option value="AFASTADO" selected?={ f.Status == "AFASTADO" }>Afastado</option><option value="FERIAS" selected?={ f.Status == "FERIAS" }>Férias</option><option value="DESLIGADO" selected?={ f.Status == "DESLIGADO" }>Desligado</option></select></div>
			<div class="campo"><label for="tipoContrato">Tipo de contrato *</label><select id="tipoContrato" name="tipoContrato" required><option value="CLT" selected?={ f.TipoContrato == "CLT" || f.TipoContrato == "" }>CLT</option><option value="PJ" selected?={ f.TipoContrato == "PJ" }>Prestador/PJ</option><option value="TEMPORARIO" selected?={ f.TipoContrato == "TEMPORARIO" }>Temporário</option><option value="ESTAGIO" selected?={ f.TipoContrato == "ESTAGIO" }>Estágio</option><option value="APRENDIZ" selected?={ f.TipoContrato == "APRENDIZ" }>Aprendiz</option></select></div>
			<div class="campo"><label for="obraId">Obra atual</label><select id="obraId" name="obraId"><option value="">Administrativo/sem obra</option>
				for _, o := range f.Obras {
					<option value={ o.ID } selected?={ o.ID == f.ObraID }>{ o.Rotulo }</option>
				}
			</select></div>
			<div class="campo"><label for="cargoId">Cargo *</label><select id="cargoId" name="cargoId" required><option value="">Selecione</option>
				for _, c := range f.Cargos {
					<option value={ c.ID } selected?={ c.ID == f.CargoID }>{ c.Rotulo }</option>
				}
			</select></div>
			<div class="campo"><label for="departamentoId">Departamento/setor *</label><select id="departamentoId" name="departamentoId" required><option value="">Selecione</option>
				for _, d := range f.Departamentos {
					<option value={ d.ID } selected?={ d.ID == f.DepartamentoID }>{ d.Rotulo }</option>
				}
			</select></div>
			<div class="campo"><label for="nivelObra">Nível na obra</label><select id="nivelObra" name="nivelObra"><option value="">Não se aplica</option><option value="GERENTE_DE_OBRAS" selected?={ f.NivelObra == "GERENTE_DE_OBRAS" }>Gerente de obras</option><option value="ENGENHEIRO" selected?={ f.NivelObra == "ENGENHEIRO" }>Engenheiro</option><option value="MESTRE_DE_OBRAS" selected?={ f.NivelObra == "MESTRE_DE_OBRAS" }>Mestre de obras</option><option value="ENCARREGADO" selected?={ f.NivelObra == "ENCARREGADO" }>Encarregado</option><option value="OFICIAL" selected?={ f.NivelObra == "OFICIAL" }>Oficial</option><option value="MEIO_OFICIAL" selected?={ f.NivelObra == "MEIO_OFICIAL" }>Meio oficial</option><option value="SERVENTE_AJUDANTE" selected?={ f.NivelObra == "SERVENTE_AJUDANTE" }>Servente/Ajudante</option></select></div>
			<div class="campo"><label for="salario">Salário *</label><input id="salario" name="salario" type="number" min="0.01" step="0.01" required value={ f.Salario }/></div>

			<h2>Dados bancários</h2>
			<p>Ao informar dados bancários, preencha banco, agência, conta e tipo de conta.</p>
			<div class="campo"><label for="banco">Banco</label><input id="banco" name="banco" value={ f.Banco }/></div>
			<div class="campo"><label for="agencia">Agência</label><input id="agencia" name="agencia" value={ f.Agencia }/></div>
			<div class="campo"><label for="conta">Conta</label><input id="conta" name="conta" value={ f.Conta }/></div>
			<div class="campo"><label for="tipoConta">Tipo de conta</label><select id="tipoConta" name="tipoConta"><option value="">Selecione</option><option value="CORRENTE" selected?={ f.TipoConta == "CORRENTE" }>Corrente</option><option value="POUPANCA" selected?={ f.TipoConta == "POUPANCA" }>Poupança</option><option value="SALARIO" selected?={ f.TipoConta == "SALARIO" }>Salário</option></select></div>
			<div class="campo"><label for="chavePix">Chave PIX</label><input id="chavePix" name="chavePix" value={ f.ChavePix }/></div>

			<h2>Uniforme e observações</h2>
			<div class="campo"><label for="tamanhoCamisa">Camisa</label><input id="tamanhoCamisa" name="tamanhoCamisa" value={ f.TamanhoCamisa }/></div>
			<div class="campo"><label for="tamanhoCalca">Calça</label><input id="tamanhoCalca" name="tamanhoCalca" value={ f.TamanhoCalca }/></div>
			<div class="campo"><label for="tamanhoCalcado">Calçado</label><input id="tamanhoCalcado" name="tamanhoCalcado" value={ f.TamanhoCalcado }/></div>
			<div class="campo"><label for="observacoes">Observações</label><textarea id="observacoes" name="observacoes" rows="4">{ f.Observacoes }</textarea></div>
			if f.Erro != "" {
				<p role="alert">{ f.Erro }</p>
			}
			<button type="submit" data-testid="salvar">Salvar funcionário</button>
		</form>
	}
}

func tituloForm(id string) string { if id == "" { return "Novo funcionário" }; return "Editar funcionário" }
func acaoForm(id string) string { if id == "" { return "/rh/funcionarios" }; return "/rh/funcionarios/" + id }
