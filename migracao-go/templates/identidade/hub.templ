package identidade

type ItemSistema struct {
	Modulo, Rotulo, Descricao, URL string
}

templ Hub(
	nomePrimeiro string,
	rotuloCargo string,
	descricaoCargo string,
	liberados []ItemSistema,
	bloqueados []ItemSistema,
	podeLancar bool,
	podeAprovar bool,
	ehAdmin bool,
) {
	@Pagina("Hub") {
		<h1>Olá, { nomePrimeiro }</h1>
			<p>
				<span class="selo">{ rotuloCargo }</span>
				{ descricaoCargo }
			</p>

			<section aria-label="Sistemas">
				<h2>Seus sistemas</h2>
				if len(liberados) == 0 {
					<p>Você ainda não tem acesso a nenhum sistema. Peça ao administrador para liberar.</p>
				} else {
					<div class="grade-sistemas">
						for _, s := range liberados {
							<a href={ templ.URL(s.URL) } data-testid={ "sistema-" + s.Modulo }>
								<span>{ s.Rotulo }</span>
								<span class="descricao">{ s.Descricao }</span>
							</a>
						}
					</div>
				}
			</section>

			if len(bloqueados) > 0 {
				<section aria-label="Sem acesso" style="margin-top:1.5rem">
					<h2>Sem acesso</h2>
					for _, s := range bloqueados {
						<span class="bloqueado">{ s.Rotulo }</span>
					}
				</section>
			}

			<section class="card" style="margin-top:1.5rem">
				<h2>O que o seu cargo permite</h2>
				<ul>
					<li>{ marca(podeLancar) } Lançar no dia a dia (cadastrar, movimentar, registrar)</li>
					<li>{ marca(podeAprovar) } Aprovar o que outra pessoa lançou</li>
					<li>{ marca(ehAdmin) } Cadastrar usuários e definir cargos</li>
				</ul>
			</section>
	}
}

func marca(ativo bool) string {
	if ativo {
		return "✓"
	}
	return "—"
}
