package painel

type LinhaFornecedor struct {
	ID, Nome, Telefone, AliasesTexto string
	Ativo                            bool
	QtdLocacoes                      int
}

type FormFornecedor struct {
	Aberto                          bool
	Erro                            string
	ID, Nome, Telefone, Aliases     string
}

templ Fornecedores(linhas []LinhaFornecedor, form FormFornecedor) {
	@Pagina("Fornecedores") {
		<h1>Fornecedores</h1>

		<details open?={ form.Aberto }>
			<summary data-testid="novo-fornecedor" class="botao botao-primario">+ Novo fornecedor</summary>
			<form class="formulario" method="POST" action="/painel/fornecedores" style="margin-top:0.75rem">
				<input type="hidden" name="id" value={ form.ID }/>
				<div class="campo">
					<label for="nome">Nome *</label>
					<input id="nome" name="nome" required?={ true } value={ form.Nome }/>
				</div>
				<div class="campo">
					<label for="telefone">Telefone</label>
					<input id="telefone" name="telefone" value={ form.Telefone }/>
				</div>
				<div class="campo">
					<label for="aliases">Apelidos (separados por vírgula)</label>
					<input id="aliases" name="aliases" value={ form.Aliases }/>
					<small>Grafias que aparecem na planilha e devem cair neste fornecedor.</small>
				</div>
				if form.Erro != "" {
					<p role="alert" data-testid="erro-fornecedor" class="erro">{ form.Erro }</p>
				}
				<button type="submit" data-testid="salvar-fornecedor">Salvar</button>
			</form>
		</details>

		<ul class="lista-usuarios" data-testid="lista-fornecedores" style="margin-top:1rem">
			for _, f := range linhas {
				<li>
					<div class="linha-topo">
						<span class="nome">{ f.Nome }<br/><span class="email">{ f.AliasesTexto }</span></span>
						<span class="email">{ f.QtdLocacoes } locações</span>
						if !f.Ativo {
							<span style="color:var(--danger)">inativo</span>
						}
						<form method="POST" action={ templ.URL("/painel/fornecedores/" + f.ID + "/alternar") } style="display:inline">
							<input type="hidden" name="ativo" value={ ativaToggle(f.Ativo) }/>
							<button type="submit" data-testid={ "alternar-fornecedor-" + f.Nome }>{ rotuloAlternar(f.Ativo) }</button>
						</form>
					</div>
				</li>
			}
		</ul>
	}
}
