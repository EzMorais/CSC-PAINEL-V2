# Copie para ".env" (mesma pasta do docker-compose.yml) e preencha. Ver DEPLOY.md.
#
# Só os endereços PÚBLICOS de cada sistema — o "NEXT_PUBLIC_" no nome já diz: ficam
# visíveis no navegador de qualquer jeito, então não tem problema de segurança em morarem
# aqui. Eles precisam existir JÁ NO MOMENTO DO BUILD (não só ao rodar o contêiner) porque o
# Next.js grava esses valores dentro do JavaScript que vai pro navegador durante o
# "next build" — é por isso que este arquivo é separado dos ".env.production" de cada app
# (aqueles só valem em tempo de execução) e por isso o docker-compose.yml passa estes aqui
# como "build args".

NEXT_PUBLIC_URL_PORTAL=https://sistemas.SEUDOMINIO.com.br
NEXT_PUBLIC_URL_PAINEL=https://sistemas.SEUDOMINIO.com.br/painel
NEXT_PUBLIC_URL_RH=https://sistemas.SEUDOMINIO.com.br/rh
NEXT_PUBLIC_URL_ESTOQUE=https://sistemas.SEUDOMINIO.com.br/almoxarifado
NEXT_PUBLIC_URL_PROGRAMACAO=https://sistemas.SEUDOMINIO.com.br/programacao
NEXT_PUBLIC_URL_CADASTROS=https://sistemas.SEUDOMINIO.com.br/cadastros
NEXT_PUBLIC_URL_ALOJAMENTOS=https://sistemas.SEUDOMINIO.com.br/alojamentos
# Frota entrou no grupo de login único em 2026-08-11 — deixou de ter subdomínio próprio.
NEXT_PUBLIC_URL_FROTA=https://sistemas.SEUDOMINIO.com.br/frota

# Opcional — autocompletar de endereço no cadastro de obras dos Alojamentos. Sem uma chave
# válida, essa parte específica não funciona; o resto do sistema segue normal.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
