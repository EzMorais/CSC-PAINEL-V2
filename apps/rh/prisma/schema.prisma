generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Mesma forma da tabela do Painel de Locação, de propósito.
///
/// Os dois sistemas assinam o cookie de sessão com o mesmo AUTH_SECRET e usam o mesmo
/// nome de cookie, e cookie não separa por porta — só por host. Então quem entra no
/// painel em :3000 já chega autenticado aqui em :3002, sem segundo login. Esta tabela
/// existe para o RH conseguir autenticar por conta própria quando alguém abre direto
/// nele; o seed mantém o mesmo usuário admin nos dois bancos.
model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     String   @default("OPERADOR") // ADMIN | OPERADOR
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
}

/// Espelha o cadastro de obras do painel (mesmos campos que importam aqui).
///
/// Banco separado significa que não dá para usar a linha do painel por chave estrangeira.
/// O `codigo` é a chave natural que liga as duas bases: é único nos dois lados, e é por
/// ele que uma sincronização futura casaria os registros.
model Obra {
  id          String   @id @default(cuid())
  codigo      String   @unique
  cliente     String
  descricao   String
  responsavel String?
  ativa       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  funcionarios Funcionario[]
  eventos      Evento[]

  @@index([cliente])
}

model Cargo {
  id       String   @id @default(cuid())
  nome     String   @unique
  cbo      String?
  /// Insalubridade/periculosidade puxam exigência de EPI e exame específicos.
  risco    String   @default("NORMAL") // NORMAL | INSALUBRE | PERICULOSO
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  funcionarios Funcionario[]
}

model Funcionario {
  id        String @id @default(cuid())
  matricula String @unique
  nome      String

  // ── dados pessoais ────────────────────────────────────────────────────────
  cpf            String    @unique
  rg             String?
  dataNascimento DateTime?
  sexo           String?
  estadoCivil    String?
  nomeMae        String?

  // ── contato ───────────────────────────────────────────────────────────────
  telefone String?
  email    String?

  // ── endereço ──────────────────────────────────────────────────────────────
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  // ── contrato ──────────────────────────────────────────────────────────────
  /// Status não é derivado: afastamento e férias são decisões registradas, não
  /// consequências de data. Só o desligamento tem data própria (`demitidoEm`).
  status       String    @default("ATIVO") // ATIVO | AFASTADO | FERIAS | DESLIGADO
  admitidoEm   DateTime
  demitidoEm   DateTime?
  motivoSaida  String?
  salario      Float?
  tipoContrato String    @default("CLT") // CLT | PJ | TEMPORARIO | APRENDIZ

  // ── banco ─────────────────────────────────────────────────────────────────
  banco     String?
  agencia   String?
  conta     String?
  tipoConta String?
  chavePix  String?

  // ── vestuário: o tamanho vive aqui porque não muda a cada entrega ─────────
  tamanhoCamisa  String?
  tamanhoCalca   String?
  tamanhoCalcado String?

  observacoes String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  obra    Obra?   @relation(fields: [obraId], references: [id])
  obraId  String?
  cargo   Cargo?  @relation(fields: [cargoId], references: [id])
  cargoId String?

  dependentes      Dependente[]
  eventos          Evento[]
  entregasUniforme EntregaUniforme[]
  treinamentos     TreinamentoParticipante[]

  @@index([obraId])
  @@index([cargoId])
  @@index([status])
  @@index([nome])
}

model Dependente {
  id             String    @id @default(cuid())
  nome           String
  parentesco     String // FILHO | CONJUGE | OUTRO
  dataNascimento DateTime?
  cpf            String?
  /// Dependente para IR e para salário-família seguem regras diferentes; guardar os
  /// dois separados evita ter que reinterpretar a idade depois.
  irrf           Boolean   @default(false)
  salarioFamilia Boolean   @default(false)
  criadoEm       DateTime  @default(now())

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String

  @@index([funcionarioId])
}

/// Entrega de uniforme a um funcionário — recibo, não cadastro.
///
/// `tamanho` é gravado aqui de novo, mesmo já existindo em `Funcionario.tamanhoCamisa` etc.,
/// porque o cadastro pode mudar depois (funcionário engordou, trocou de calçado) e isso não
/// pode reescrever o que foi entregue no passado. `assinatura` é a imagem (PNG em data URI)
/// desenhada na hora, gravada como texto porque este app não tem nenhum armazenamento de
/// arquivo (disco, S3) — é só SQLite, e um campo de texto resolve sem criar uma dependência
/// nova. É append-only, como `Evento`: um recibo emitido errado se corrige com uma nova
/// entrega, não editando a antiga.
model EntregaUniforme {
  id            String   @id @default(cuid())
  peca          String // CAMISA | CALCA | CALCADO | OUTRO
  tamanho       String
  quantidade    Int      @default(1)
  motivo        String // ADMISSAO | REPOSICAO | TROCA | DANIFICADO
  entregueEm    DateTime
  observacao    String?
  assinatura    String?
  registradoPor String?
  criadoEm      DateTime @default(now())

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String

  @@index([funcionarioId, entregueEm])
}

/// Uma turma de treinamento — uma sessão, ministrada uma vez, para um grupo de
/// funcionários. `validadeEm` é digitado por quem registra a turma, não calculado a
/// partir de `norma`: os prazos de reciclagem de cada NR variam e mudam por norma
/// regulamentadora, e cravar esse número no código arriscaria informar um prazo errado
/// para uma obrigação de segurança do trabalho. Turma sem validade (ex.: integração) é
/// válida — o alerta de reciclagem simplesmente não se aplica a ela.
model Treinamento {
  id            String    @id @default(cuid())
  norma         String // NR_10 | NR_18 | NR_33 | NR_35 | OUTRA
  descricao     String
  instrutor     String?
  cargaHoraria  Int?
  realizadoEm   DateTime
  validadeEm    DateTime?
  registradoPor String?
  criadoEm      DateTime  @default(now())

  participantes TreinamentoParticipante[]

  @@index([validadeEm])
  @@index([norma])
}

/// Quem participou de uma turma — e o certificado dessa pessoa, se já foi anexado.
///
/// Certificado é por participante (cada um recebe o seu, com o próprio nome), não por
/// turma. Gravado como data URI em texto pelo mesmo motivo de `EntregaUniforme.assinatura`:
/// este app não tem armazenamento de arquivo próprio, só SQLite.
model TreinamentoParticipante {
  id          String   @id @default(cuid())
  certificado String?
  criadoEm    DateTime @default(now())

  treinamento   Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  treinamentoId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String

  @@unique([treinamentoId, funcionarioId])
  @@index([funcionarioId])
}

/// Linha do tempo do funcionário — a fonte da verdade sobre o que aconteceu e quando.
///
/// É append-only: nada aqui é editado ou apagado quando o cadastro muda. Trocar a obra
/// de um funcionário sobrescreve `Funcionario.obraId`, mas a passagem pela obra anterior
/// continua legível aqui. Era exatamente essa história que a planilha antiga destruía.
model Evento {
  id              String   @id @default(cuid())
  tipo            String // ADMISSAO | MUDANCA_CARGO | MUDANCA_OBRA | AFASTAMENTO | RETORNO |
  // FERIAS | ADVERTENCIA | PROMOCAO | DESLIGAMENTO | OBSERVACAO
  descricaoHumana String
  detalhe         String?
  /// Quando o fato ocorreu, que nem sempre é quando foi digitado.
  ocorridoEm      DateTime
  registradoEm    DateTime @default(now())
  /// Nome de quem registrou, copiado da sessão. Texto e não relação: o registro tem de
  /// sobreviver à exclusão do usuário que o criou.
  registradoPor   String?

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String
  obra          Obra?       @relation(fields: [obraId], references: [id])
  obraId        String?

  @@index([funcionarioId, ocorridoEm])
  @@index([obraId])
  @@index([tipo])
}
