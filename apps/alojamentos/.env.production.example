# Copie para ".env.production" e preencha. Ver DEPLOY.md na raiz do repositório.
DATABASE_URL="file:/app/data/dev.db"

# O MESMO valor precisa estar em portal, painel-locacao, rh, estoque, programacao,
# alojamentos E whatsapp — nos 6 primeiros é o segredo compartilhado do login único (SSO);
# no whatsapp é o que verifica os pedidos vindos daqui.
AUTH_SECRET="COLOQUE_O_SEGREDO_COMPARTILHADO_DOS_6_SISTEMAS_AQUI"

# Chamadas de servidor para servidor (não passam pelo navegador) — usam o nome do serviço no
# Docker, direto na rede interna, sem passar pelo nginx.
URL_RH="http://rh:3002"
URL_WHATSAPP="http://whatsapp:3006"

# Chave da API do Google Maps usada no SERVIDOR (usada no cadastro de endereço das obras).
# Gere uma em https://console.cloud.google.com/ — sem ela, o autocompletar de endereço não
# funciona, mas o resto do sistema segue normal. A versão NEXT_PUBLIC_ desta mesma chave
# (usada no navegador) vai no ".env" da RAIZ do repositório, não aqui — ver abaixo.
GOOGLE_MAPS_API_KEY="COLOQUE_SUA_CHAVE_AQUI"

# Os endereços PÚBLICOS (NEXT_PUBLIC_URL_* e NEXT_PUBLIC_GOOGLE_MAPS_API_KEY) NÃO vão neste
# arquivo — eles precisam existir já no "docker build", não só ao rodar o contêiner, porque
# o Next.js os grava dentro do JavaScript do navegador. Configure-os no ".env" da RAIZ do
# repositório (ver .env.example lá) — o docker-compose.yml repassa de lá pro build deste app.
