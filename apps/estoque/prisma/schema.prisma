generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Os usuários NÃO moram mais aqui.
///
/// Quem cadastra gente, define cargo e confere senha é o Portal (`apps/portal`), e os
/// módulos só leem o crachá de sessão que ele assina. Antes cada módulo tinha a sua tabela,
/// e criar alguém significava criar quatro vezes — com o risco garantido de o cargo mudar
/// num lugar e ficar velho nos outros.

/// Espelha o cadastro de obras dos outros módulos (só os campos que importam aqui).
///
/// Banco separado significa que não dá para usar a linha do painel por chave estrangeira.
/// O `codigo` é a chave natural que liga as bases: é único em todos os lados, e é por ele
/// que uma sincronização futura casaria os registros.
model Obra {
  id          String   @id @default(cuid())
  codigo      String   @unique
  cliente     String
  descricao   String
  responsavel String?
  ativa       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  movimentacoes Movimentacao[]

  @@index([cliente])
}

model Fornecedor {
  id       String   @id @default(cuid())
  nome     String   @unique
  cnpj     String?
  telefone String?
  email    String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  movimentacoes Movimentacao[]
}

/// O material em si — o cadastro, não a quantidade.
///
/// Repare que NÃO existe um campo `saldo` aqui. O saldo é somado a partir das
/// movimentações toda vez que é lido (ver `queries/saldos.ts`). Guardar um número aqui
/// seria mais rápido, mas cria a possibilidade de ele discordar do histórico — e quando
/// discorda, não há como saber qual dos dois está certo. Somar o histórico é sempre
/// verdade por construção: é a mesma razão pela qual o Painel de Locação calcula o status
/// em vez de gravá-lo.
///
/// `estoqueMinimo` é o ponto de alerta de compra, digitado por quem cadastra — não é
/// calculado a partir de consumo, porque consumo de obra varia demais entre fases para
/// uma média significar alguma coisa.
model Material {
  id            String   @id @default(cuid())
  codigo        String   @unique
  nome          String
  categoria     String // CIMENTO_ARGAMASSA | AGREGADO | ACO_FERRAGEM | MADEIRA | ELETRICA | ...
  unidade       String // UN | CX | KG | SC | M | M2 | M3 | L | PC | PAR | RL
  estoqueMinimo Float    @default(0)
  localizacao   String?
  observacao    String?
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  /// Certificado de Aprovação — só faz sentido em material de categoria EPI.
  ///
  /// Mora aqui e não na entrega porque o CA é do equipamento, não do ato de entregar. A
  /// NR-6 exige o número do CA na ficha de cada entrega, e a ficha copia daqui: assim o
  /// almoxarife digita uma vez, no cadastro, em vez de a cada entrega — que é onde erraria.
  ca         String?
  validadeCA DateTime?

  movimentacoes    Movimentacao[]
  itensSolicitacao ItemSolicitacao[]

  @@index([categoria])
  @@index([nome])
}

/// O livro-razão do almoxarifado: toda entrada, saída, devolução, perda e ajuste.
///
/// É append-only, como a timeline do RH. Uma movimentação lançada errado se corrige com
/// uma nova movimentação no sentido contrário, nunca editando ou apagando a antiga — se
/// desse para apagar, o saldo de ontem mudaria retroativamente e nenhum inventário
/// fechado voltaria a fechar.
///
/// `quantidade` é SEMPRE positiva. O sinal vem do `tipo`, não do número: cada tipo tem
/// exatamente uma direção (ver `SINAL_MOVIMENTACAO` em `lib/dominio/constantes.ts`).
/// Misturar sinal dentro da coluna faria uma saída digitada como positiva somar em vez de
/// subtrair, sem nada na tela denunciando o erro.
///
/// `valorUnitario` só é preenchido na entrada — é o preço pago naquela compra. Saída não
/// tem preço porque o material já foi pago quando entrou.
model Movimentacao {
  id            String   @id @default(cuid())
  tipo          String // ENTRADA | SAIDA | DEVOLUCAO | PERDA | AJUSTE_POSITIVO | AJUSTE_NEGATIVO
  quantidade    Float
  valorUnitario Float?
  documento     String?
  observacao    String?
  /// Quando o fato ocorreu, que nem sempre é quando foi digitado.
  ocorridoEm    DateTime
  registradoEm  DateTime @default(now())
  /// Nome de quem registrou, copiado da sessão. Texto e não relação: o registro tem de
  /// sobreviver à exclusão do usuário que o criou.
  registradoPor String?

  /// Quem recebeu, quando é entrega de EPI.
  ///
  /// `funcionarioId` é o id no banco do RH — bancos separados não permitem chave
  /// estrangeira, então é só um texto. `funcionarioNome` é copiado junto de propósito: sem
  /// ele, exibir o extrato exigiria uma chamada ao RH a cada linha, e o extrato de uma
  /// entrega ficaria ilegível se o RH estivesse fora do ar ou se o cadastro fosse apagado.
  funcionarioId   String?
  funcionarioNome String?

  /// Confirmação de que a ficha chegou ao RH.
  ///
  /// A entrega de EPI tem de existir no RH — é a ficha que a NR-6 exige. Mas travar a
  /// saída do material quando o RH está fora do ar impediria o almoxarife de trabalhar por
  /// causa de outro sistema, e gravar a saída fingindo que sincronizou esconderia uma ficha
  /// faltando. Então a saída acontece, e o que não sincronizou fica visível aqui para ser
  /// reenviado.
  sincronizadoEm    DateTime?
  erroSincronizacao String?

  material     Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId   String
  obra         Obra?       @relation(fields: [obraId], references: [id])
  obraId       String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])
  fornecedorId String?

  @@index([materialId, ocorridoEm])
  @@index([obraId])
  @@index([tipo])
  @@index([ocorridoEm])
  @@index([funcionarioId])
}

/// Pedido de compra nascido do que está abaixo do mínimo.
///
/// Não vira entrada sozinho: comprar é decisão de gente, e o sistema só junta a lista e
/// sugere quantidade. A entrada continua sendo lançada quando o material efetivamente
/// chega, e é ela que muda o saldo — a solicitação é o documento do pedido, não do
/// recebimento.
model SolicitacaoCompra {
  id            String    @id @default(cuid())
  numero        String    @unique
  status        String    @default("RASCUNHO") // RASCUNHO | ENVIADA | ATENDIDA | CANCELADA
  observacao    String?
  criadoEm      DateTime  @default(now())
  enviadaEm     DateTime?
  atendidaEm    DateTime?
  registradoPor String?

  /// Resultado do disparo automático por e-mail.
  ///
  /// O erro fica gravado, e não só em log, porque quem precisa saber que o pedido não saiu
  /// é o almoxarife na tela — não alguém lendo o terminal do servidor. Sem isto, uma senha
  /// de aplicativo expirada faria os pedidos pararem de sair em silêncio.
  emailEnviadoPara String?
  emailEnviadoEm   DateTime?
  emailErro        String?

  itens ItemSolicitacao[]

  @@index([status])
}

/// Pedido de autorização para um lançamento que o cargo Operacional não fecha sozinho.
///
/// Guarda o que SERIA feito, não o que foi feito: enquanto está pendente, nada mudou no
/// saldo nem saiu e-mail nenhum. A execução acontece na aprovação. O caminho contrário —
/// executar e desfazer se o gerente recusar — deixaria o estoque momentaneamente errado e,
/// no caso da compra, um e-mail já enviado ao fornecedor que não dá para "desenviar".
///
/// `dados` é JSON porque cada tipo carrega campos diferentes; validar o formato é
/// responsabilidade de quem aprova (`actions/aprovacoes.ts`), na hora de executar.
model Aprovacao {
  id     String  @id @default(cuid())
  /// AJUSTE_INVENTARIO | PERDA | SOLICITACAO_COMPRA
  tipo   String
  /// PENDENTE | APROVADA | REJEITADA
  status String  @default("PENDENTE")
  dados  String
  /// O que a pessoa escreveu para justificar o pedido.
  motivo String?
  /// Resumo legível, montado no momento do pedido. Existe para a fila de aprovação não
  /// precisar entender o JSON de cada tipo só para mostrar uma linha na tela.
  resumo String

  solicitanteId   String
  solicitanteNome String
  aprovadorId     String?
  aprovadorNome   String?
  /// Por que o gerente recusou. Sem isto, a pessoa refaz o mesmo pedido sem saber o que mudar.
  motivoRejeicao  String?

  /// Id do que foi criado quando a aprovação saiu — a ponte entre o pedido e o efeito.
  referenciaId String?

  criadoEm   DateTime  @default(now())
  decididoEm DateTime?

  @@index([status, criadoEm])
  @@index([tipo])
}

/// Conta de e-mail que dispara as solicitações de compra. Uma linha só.
///
/// Mora no banco, e não no `.env`, de propósito: quem configura isto é o almoxarife, e
/// pedir a ele que edite um arquivo de texto do servidor devolveria justamente a
/// dificuldade que a tela existe para tirar. A senha guardada aqui deve ser uma SENHA DE
/// APLICATIVO — tanto o Gmail quanto o Outlook exigem uma, e é bom que exijam: ela vale só
/// para enviar e-mail e pode ser revogada sem trocar a senha da conta.
///
/// `id` fixo em "unica" porque é configuração do sistema, não uma lista: sem isso, dois
/// cadastros acidentais deixariam o envio dependendo de qual linha viesse primeiro.
model ConfiguracaoEmail {
  id                 String  @id @default("unica")
  provedor           String  @default("GMAIL") // GMAIL | OUTLOOK | OUTRO
  host               String
  porta              Int     @default(587)
  usuario            String
  senha              String
  remetente          String?
  destinatarioPadrao String?
  copiaPara          String?
  /// Dispara o e-mail sozinho assim que uma solicitação é criada.
  enviarAutomatico   Boolean @default(true)

  /// Acima deste valor, a solicitação de compra precisa de aprovação da gerência.
  ///
  /// Zero desliga a regra. O padrão não é zero de propósito: um limite que começa
  /// desativado costuma continuar desativado, e aí a aprovação só existe no papel.
  limiteAprovacaoCompra Float @default(1000)

  /// Acima desta quantidade, o ajuste de inventário precisa de aprovação.
  ///
  /// Quantidade e não valor: o furo clássico de almoxarifado é sumir com item barato em
  /// volume, justamente o que passaria despercebido num limite em reais.
  limiteAjusteInventario Float     @default(10)
  ativo                  Boolean   @default(true)
  /// Último teste que funcionou — é o que diz se dá para confiar na configuração.
  testadoEm              DateTime?
  atualizadoEm           DateTime  @updatedAt
}

/// Um item pedido.
///
/// `saldoNaEpoca` e `minimoNaEpoca` são fotografias do momento em que o pedido foi feito,
/// não relações vivas: seis meses depois, quem lê o pedido precisa entender por que aquela
/// quantidade foi pedida, e o saldo de hoje não explica a decisão de ontem.
model ItemSolicitacao {
  id            String  @id @default(cuid())
  quantidade    Float
  saldoNaEpoca  Float
  minimoNaEpoca Float
  precoEstimado Float?
  observacao    String?

  solicitacao   SolicitacaoCompra @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  solicitacaoId String
  material      Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId    String

  @@unique([solicitacaoId, materialId])
  @@index([materialId])
}
