# Copie para ".env.production" e preencha. Ver DEPLOY.md na raiz do repositório.
DATABASE_URL="file:/app/data/dev.db"

# O MESMO valor precisa estar em portal, painel-locacao, rh, estoque, programacao e
# alojamentos — é o segredo compartilhado que faz o login do Portal valer nos outros
# sistemas (SSO). Gere um valor com o comando do DEPLOY.md e cole idêntico nos 6 arquivos.
AUTH_SECRET="COLOQUE_O_SEGREDO_COMPARTILHADO_DOS_6_SISTEMAS_AQUI"

# Sem HTTPS o cookie de sessão nunca seria enviado pelo navegador. Como o VPS terá HTTPS
# (nginx + Let's Encrypt), mantenha em 1.
FORCA_HTTPS=1

# Os endereços PÚBLICOS (NEXT_PUBLIC_URL_*) de cada sistema NÃO vão neste arquivo — eles
# precisam existir já no "docker build", não só ao rodar o contêiner, porque o Next.js os
# grava dentro do JavaScript do navegador. Configure-os no ".env" da RAIZ do repositório
# (ver .env.example lá) — o docker-compose.yml repassa de lá pro build de cada app.
