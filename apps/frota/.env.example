DATABASE_URL="file:./frota.db"
# Precisa ser o MESMO valor usado pelos outros apps do grupo de login único (Portal, RH,
# Almoxarifado, Painel, Alojamentos, Programação, migracao-go) — é o SSO compartilhado que
# faz o login do Portal valer aqui, desde 2026-08-11 (antes o Frota tinha segredo próprio).
AUTH_SECRET="troque-este-segredo-em-producao-com-uma-string-longa-aleatoria"
# Onde o Portal responde — usado só para montar o link de "entrar" quando a sessão falta.
NEXT_PUBLIC_URL_PORTAL="http://localhost:3010"
PASTA_ANEXOS="./public/anexos"
# SMTP (opcional — alertas por e-mail)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_DE="frota@siqueiracampos.com.br"
ALERTA_PARA=""
