# dependências
node_modules/

# build
.next/
out/
# cache incremental do TypeScript: é regenerado sozinho a cada `tsc`, e versionado
# aparecia como "modificado" toda vez que alguém rodava uma checagem de tipos.
tsconfig.tsbuildinfo

# dados locais — nunca versionar
dados/
*.db
*.db-shm
*.db-wal

# segredos
.env
.env.local

# anexos enviados pelos usuários
public/anexos/*
!public/anexos/.gitkeep

# testes
test-results/
playwright-report/

# logs de execução local
*.log
