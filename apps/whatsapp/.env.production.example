# Copie para ".env.production" e preencha. Ver DEPLOY.md na raiz do repositório.
#
# PASTA_SESSAO e PORTA_WHATSAPP já vêm fixos no Dockerfile — não precisa repetir aqui.

# O MESMO valor usado em portal, painel-locacao, rh, estoque, programacao e alojamentos —
# é o que verifica os pedidos assinados que os Alojamentos enviam pra cá.
AUTH_SECRET="COLOQUE_O_SEGREDO_COMPARTILHADO_DOS_6_SISTEMAS_AQUI"

# Chamada de servidor para servidor, direto na rede interna do Docker.
URL_ALOJAMENTOS="http://alojamentos:3005"

# "1" pra ver os logs internos do Baileys (biblioteca do WhatsApp) quando estiver
# investigando um problema de conexão. Deixe vazio no dia a dia — é bem verboso.
LOG_BAILEYS=
